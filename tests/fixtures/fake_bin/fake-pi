#!/usr/bin/env python3
"""Fake `pi --mode json -p` for tests. Emits a two-line JSONL stream."""
import json
import os
import sys
import uuid

if os.environ.get("FAKE_PI_FAIL") == "1":
    print("pi broken", file=sys.stderr)
    sys.exit(1)

print(json.dumps({"type": "session", "id": f"fake-pi-sess-{uuid.uuid4()}"}))
print(json.dumps({
    "type": "agent_end",
    "messages": [{"role": "assistant", "content": "FAKE PI ANSWER"}],
}))
