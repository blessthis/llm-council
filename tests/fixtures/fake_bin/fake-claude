#!/usr/bin/env python3
"""Fake `claude -p --output-format json` for tests. Emits one JSON line."""
import json
import os
import sys
import uuid

if os.environ.get("FAKE_CLAUDE_FAIL") == "1":
    print("fake auth error", file=sys.stderr)
    sys.exit(1)

argv = sys.argv[1:]
session_id = f"fake-sess-{uuid.uuid4()}"
for i, a in enumerate(argv):
    if a == "--resume" and i + 1 < len(argv):
        session_id = f"fake-sess-resumed-{argv[i + 1][:8]}"

result = {
    "type": "result",
    "subtype": "success",
    "session_id": session_id,
    "result": "FAKE CLAUDE ANSWER: prompt received",
    "usage": {
        "input_tokens": 100,
        "output_tokens": 50,
        "cache_read_input_tokens": 10,
        "cache_creation_input_tokens": 5,
    },
    "num_turns": 2,
    "total_cost_usd": 0.001,
}
print(json.dumps(result))
