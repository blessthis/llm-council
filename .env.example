# --- LLM gateway (CLIProxyAPI at llm.blessthis.software) ---
# The agent talks ONE Anthropic wire format (/v1/messages) to this gateway for ALL models.
GATEWAY_BASE_URL=https://llm.blessthis.software
GATEWAY_API_KEY=

# Default model for new sessions. Any model the gateway serves:
#   claude-opus-4-8, claude-sonnet-4-6, gemini-2.5-pro, minimax-m2, glm-4.6, ...
# NOTE: only claude-* sessions get true Anthropic prompt-cache reuse (native passthrough).
DEFAULT_MODEL=claude-sonnet-4-6

# --- Session store (local Postgres on this Mac) ---
DATABASE_URL=postgresql://murich@localhost:5432/llm_council

# --- Default sandbox root for new sessions (overridable per session) ---
DEFAULT_SANDBOX_DIR=/Users/murich/agent-workspace

# --- ast-grep binary, surfaced into the agent's context for structural search ---
AST_GREP_PATH=/opt/homebrew/bin/ast-grep

# --- MiniMax (direct, for async video generation — NOT via gateway) ---
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io

# Max agent tool-call iterations per turn (a "wrap up" reminder fires 10 turns before
# this cap so seats conclude instead of being cut off mid-investigation).
MAX_AGENT_ITERATIONS=40

# Auto-compact a session once context usage reaches this fraction of the model's
# window (0 disables). Per-session override via the set_auto_compact tool.
AUTO_COMPACT_THRESHOLD=0.85
